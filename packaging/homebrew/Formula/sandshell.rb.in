# This formula is generated by scripts/homebrew-formula.sh from
# packaging/homebrew/Formula/sandshell.rb.in. Regenerate it with real
# release metadata (GitHub owner, version, release-archive SHA256); do not
# edit the generated file by hand. It belongs in the separate
# homebrew-sandshell tap repository at Formula/sandshell.rb.
# See packaging/homebrew/README.md for the release flow.

class Sandshell < Formula
  desc "Small Bash/Zsh helpers for Docker Sandboxes"
  homepage "https://github.com/@OWNER@/homebrew-sandshell"
  url "https://github.com/@OWNER@/homebrew-sandshell/releases/download/v@VERSION@/sandshell-@VERSION@.tar.gz"
  sha256 "@SHA256@"
  license "MIT"

  def install
    libexec.install "sandshell.sh"
    bash_completion.install "completions/sandshell.bash"
    zsh_completion.install "completions/_sandshell" => "_sandshell"
    (pkgshare/"examples").install "examples/vibe.toml"
  end

  def caveats
    <<~EOS
      Source sandshell from your shell configuration (~/.zshrc or ~/.bashrc),
      preferably near the end of the file so shell completion setup is
      already available:

        source "$(brew --prefix sandshell)/libexec/sandshell.sh"

      Homebrew installed the Bash and Zsh completions automatically.

      An example Vibe configuration is installed at
      $(brew --prefix sandshell)/share/sandshell/examples/vibe.toml; copy it
      to ~/.config/sandshell/agents/vibe.toml to customize Vibe. The runtime
      never reads this file.
    EOS
  end

  test do
    # Source the installed runtime in Bash and confirm the public helper
    # functions exist. Needs no sandbox backend and no network access.
    system "bash", "-c", ". #{libexec}/sandshell.sh && " \
                         "command -v sbxc && command -v sbxr && " \
                         "command -v sbxenv && command -v sbxmcp && " \
                         "command -v sbxskill && command -v sbxwt && " \
                         "command -v sbxcmd && sbxcmd"
    # The optional Vibe example is installed as a public data asset.
    assert_path_exists pkgshare/"examples/vibe.toml"
  end
end

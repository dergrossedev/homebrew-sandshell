#!/usr/bin/env bash
# Mock `sbx` CLI for the Sandshell test suite.
#
# All state lives under $SBX_MOCK_STATE (a per-test temporary directory):
#   sandboxes/<name>   tab-separated key/value records (agent, workspace, status, mcp)
#   fs/<name>/...      fake in-sandbox filesystem (the sandbox's "/")
#   mcp-registry/      <server>.json files backing `sbx mcp ls/inspect`
#   calls.log          one line per invocation, arguments space-joined
#
# `sbx exec ... sh -c '<script>'` replays the real in-sandbox script against
# the fake filesystem: every /home/agent path is rewritten into fs/<name>/.
# stdin is forwarded untouched, so tar pipes and config copies behave like the
# real VM, including the scripts' own exit codes (42/43 refusals included).

set -u

state=${SBX_MOCK_STATE:?SBX_MOCK_STATE is not set}
sandboxes="$state/sandboxes"
registry="$state/mcp-registry"
fs_root="$state/fs"
launched="$state/launched"
mkdir -p "$sandboxes" "$registry" "$fs_root" "$launched"

printf '%s\n' "$*" >>"$state/calls.log"

field() { # FILE KEY -> value
  [ -f "$1" ] || return 1
  awk -F '\t' -v k="$2" '$1 == k { print substr($0, index($0, "\t") + 1); exit }' "$1"
}

setfield() { # FILE KEY VALUE
  local tmp
  tmp=$(mktemp)
  if [ -f "$1" ]; then
    awk -F '\t' -v k="$2" -v v="$3" '
      $1 == k { print k "\t" v; found = 1; next }
      { print }
      END { if (!found) print k "\t" v }
    ' "$1" >"$tmp"
    mv "$tmp" "$1"
  else
    printf '%s\t%s\n' "$2" "$3" >"$1"
  fi
}

skill_store() {
  case $(uname -s) in
    Darwin) printf '%s\n' "$HOME/Library/Application Support/com.docker.sandboxes/sandboxes/agent-skills" ;;
    *) printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/sandboxes/sandboxes/agent-skills" ;;
  esac
}

run_sandbox_script() { # NAME SCRIPT [ARGS...]
  local name=$1 script=$2
  shift 2
  local fs="$fs_root/$name"
  local transformed arg
  local -a rewritten=()
  # Rewrite /home/agent in the script AND in every argument: sandshell passes
  # in-sandbox paths (e.g. the skill target dir) as script arguments, and the
  # fake filesystem must be the only tree the script can touch.
  transformed=$(printf '%s' "$script" | sed "s|/home/agent|$fs/home/agent|g")
  # macOS Bash 3.2 treats an empty array expansion as unbound under `set -u`.
  if [ "$#" -eq 0 ]; then
    bash -c "$transformed"
    return
  fi
  for arg in "$@"; do
    rewritten+=("$(printf '%s' "$arg" | sed "s|/home/agent|$fs/home/agent|g")")
  done
  bash -c "$transformed" "${rewritten[@]}"
}

do_exec() {
  local name script record user='' workdir=''
  while [ $# -gt 0 ]; do
    case $1 in
      -i) shift ;;
      -u) user=$2; shift 2 ;;
      -w) workdir=$2; shift 2 ;;
      -*) printf 'mock sbx: unsupported exec flag: %s\n' "$1" >&2; exit 2 ;;
      *) break ;;
    esac
  done
  name=$1
  shift
  record="$sandboxes/$name"
  if [ ! -f "$record" ]; then
    printf 'mock sbx: no such sandbox: %s\n' "$name" >&2
    exit 1
  fi
  if [ "${1:-}" = "true" ]; then
    setfield "$record" status running
    exit "${SBX_MOCK_START_RC:-0}"
  fi
  case ${1:-} in
    vibe|opencode|claude|codex|uv)
      [ "$user" = agent ] && [ "$workdir" = /tmp ] && [ ! -t 0 ] && [ ! -t 1 ] || {
        printf 'mock sbx: updater must use agent, /tmp, and no TTY\n' >&2
        exit 2
      }
      if [ $# -eq 2 ] && [ "$2" = --version ] && [ "$1" != uv ]; then
        if [ -f "$state/updated-$name" ]; then
          [ "${SBX_MOCK_VERSION_AFTER_RC:-0}" -eq 0 ] || exit "$SBX_MOCK_VERSION_AFTER_RC"
          if [ "$1" = vibe ]; then
            printf '%s\n' "${SBX_MOCK_VERSION_AFTER:-Mistral Vibe v2.26.1}"
          else
            printf '%s\n' "${SBX_MOCK_VERSION_AFTER:-1.2.0}"
          fi
        else
          [ "${SBX_MOCK_VERSION_BEFORE_RC:-0}" -eq 0 ] || exit "$SBX_MOCK_VERSION_BEFORE_RC"
          if [ "$1" = vibe ]; then
            printf '%s\n' "${SBX_MOCK_VERSION_BEFORE:-Mistral Vibe v2.25.5}"
          else
            printf '%s\n' "${SBX_MOCK_VERSION_BEFORE:-1.1.0}"
          fi
        fi
        exit 0
      fi
      if { [ $# -eq 4 ] && [ "$1" = opencode ] && [ "$2" = upgrade ] && [ "$3" = --method ] && [ "$4" = npm ]; } ||
         { [ $# -eq 2 ] && { [ "$1" = claude ] || [ "$1" = codex ]; } && [ "$2" = update ]; } ||
         { [ $# -eq 7 ] && [ "$1" = uv ] && [ "$2" = tool ] && [ "$3" = install ] && [ "$4" = --force ] &&
           [ "$5" = mistral-vibe@latest ] && [ "$6" = --with ] && [ "$7" = 'httpx[socks]' ]; }; then
        : >"$state/updated-$name"
        if [ -n "${SBX_MOCK_UPDATE_SIGNAL:-}" ]; then kill -"$SBX_MOCK_UPDATE_SIGNAL" "$PPID"; fi
        exit "${SBX_MOCK_UPDATE_RC:-0}"
      fi
      ;;
  esac
  if [ "${1:-}" = "sh" ] && [ "${2:-}" = "-c" ]; then
    script=$3
    shift 3
    run_sandbox_script "$name" "$script" "$@"
    exit $?
  fi
  printf 'mock sbx: unsupported exec payload: %s\n' "$*" >&2
  exit 2
}

cmd_ls() {
  local f
  [ "${SBX_MOCK_LS_RC:-0}" -eq 0 ] || return "$SBX_MOCK_LS_RC"
  if [ "${1:-}" = "-q" ]; then
    for f in "$sandboxes"/*; do
      [ -f "$f" ] && basename "$f"
    done
    return 0
  fi
  printf 'NAME\tAGENT\tSTATUS\tWORKSPACE\n'
  for f in "$sandboxes"/*; do
    [ -f "$f" ] || continue
    printf '%s\t%s\t%s\t%s\n' \
      "$(basename "$f")" "$(field "$f" agent)" "$(field "$f" status)" "$(field "$f" workspace)"
  done
}

cmd_create() {
  local name='' target='' workspace='' arg
  while [ $# -gt 0 ]; do
    case $1 in
      --name) name=$2; shift 2 ;;
      --cpus|--memory|--pull|--skills|--env-file) shift 2 ;;
      --clone) shift ;;
      *)
        arg=$1
        shift
        if [ -z "$target" ]; then target=$arg; else workspace=$arg; fi
        ;;
    esac
  done
  if [ -z "$name" ] || [ -z "$target" ] || [ -z "$workspace" ]; then
    printf 'mock sbx: invalid create arguments\n' >&2
    return 2
  fi
  if [ -e "$sandboxes/$name" ]; then
    printf 'mock sbx: sandbox already exists: %s\n' "$name" >&2
    return 1
  fi
  printf 'agent\t%s\nworkspace\t%s\nstatus\tstopped\n' "$target" "$workspace" >"$sandboxes/$name"
  mkdir -p "$fs_root/$name"
}

cmd_run() {
  local name='' record
  while [ $# -gt 0 ]; do
    case $1 in
      --name) name=$2; shift 2 ;;
      *) shift ;;
    esac
  done
  record="$sandboxes/$name"
  if [ ! -f "$record" ]; then
    printf 'mock sbx: no such sandbox: %s\n' "$name" >&2
    return 1
  fi
  setfield "$record" status running
  # Snapshot the sandbox Vibe config at launch time so tests can prove which
  # configuration the agent saw when it started.
  if [ -f "$fs_root/$name/home/agent/.vibe/config.toml" ]; then
    cp "$fs_root/$name/home/agent/.vibe/config.toml" "$launched/$name.config"
  else
    rm -f "$launched/$name.config"
  fi
}

cmd_rm() {
  local name=''
  while [ $# -gt 0 ]; do
    case $1 in
      --force|-f) shift ;;
      *) name=$1; shift ;;
    esac
  done
  if [ ! -e "$sandboxes/$name" ]; then
    printf 'mock sbx: no such sandbox: %s\n' "$name" >&2
    return 1
  fi
  # name was validated against an existing sandbox record above.
  # shellcheck disable=SC2115
  rm -rf "$sandboxes/$name" "$fs_root/$name"
}

cmd_stop() {
  local name=${1:-} record
  [ "${SBX_MOCK_STOP_RC:-0}" -eq 0 ] || return "$SBX_MOCK_STOP_RC"
  record="$sandboxes/$name"
  if [ ! -f "$record" ]; then
    printf 'mock sbx: no such sandbox: %s\n' "$name" >&2
    return 1
  fi
  setfield "$record" status stopped
}

cmd_mcp() {
  local sub=${1:-} f server sandbox record
  shift || true
  case $sub in
    ls)
      for f in "$registry"/*.json; do
        [ -f "$f" ] && basename "$f" .json
      done
      ;;
    inspect)
      server=${1:-}
      if [ ! -f "$registry/$server.json" ]; then
        printf 'mock sbx: unknown MCP server: %s\n' "$server" >&2
        return 1
      fi
      cat "$registry/$server.json"
      ;;
    load)
      server=''
      sandbox=''
      while [ $# -gt 0 ]; do
        case $1 in
          --sandbox) sandbox=$2; shift 2 ;;
          *) server=$1; shift ;;
        esac
      done
      record="$sandboxes/$sandbox"
      if [ ! -f "$record" ]; then
        printf 'mock sbx: no such sandbox: %s\n' "$sandbox" >&2
        return 1
      fi
      if [ ! -f "$registry/$server.json" ]; then
        printf 'mock sbx: unknown MCP server: %s\n' "$server" >&2
        return 1
      fi
      printf 'mcp\t%s\n' "$server" >>"$record"
      ;;
    *)
      printf 'mock sbx: unsupported mcp subcommand: %s\n' "$sub" >&2
      return 2
      ;;
  esac
}

cmd_skills() {
  local sub=${1:-} store d
  shift || true
  case $sub in
    ls)
      store=$(skill_store)
      for d in "$store"/*/; do
        [ -d "$d" ] && basename "$d"
      done
      ;;
    *)
      printf 'mock sbx: unsupported skills subcommand: %s\n' "$sub" >&2
      return 2
      ;;
  esac
}

# Update-policy fixtures: one exact resource per sandbox-local TCP allow rule.
# Other scopes/decisions can be injected as native JSON rules for ownership tests.
cmd_policy() {
  local sub=${1:-} sandbox resource tmp
  shift || true
  mkdir -p "$state/policy"
  case $sub in
    ls)
      [ "${SBX_MOCK_POLICY_LS_RC:-0}" -eq 0 ] || return "$SBX_MOCK_POLICY_LS_RC"
      sandbox=$1
      shift
      [ "${1:-}" = --json ] && [ "${2:-}" = --include-inactive ] && [ $# -eq 2 ] || return 2
      if [ -f "$state/policy-response.json" ]; then
        cat "$state/policy-response.json"
        return 0
      fi
      # Same direct rule fields as the observed sbx policy ls JSON contract.
      printf '{"rules":[{"scope":"global","layer":"local","resource_type":"network","decision":"allow","resources":["pypi.org:443","files.pythonhosted.org:443"],"actions":["net:connect:tcp"]}'
      if [ -f "$state/policy/$sandbox" ]; then
        while IFS= read -r resource; do
          [ -n "$resource" ] || continue
          printf ',{"scope":"sandbox:%s","origin":"scoped","layer":"local","resource_type":"network","decision":"allow","resources":["%s"],"actions":["net:connect:tcp"],"editable":true,"provenance":{"created_via":"added"}}' "$sandbox" "$resource"
        done <"$state/policy/$sandbox"
      fi
      printf ']}\n'
      return 0 ;;
    allow|rm)
      [ "${1:-}" = network ] || return 2
      [ "${2:-}" = --sandbox ] || return 2
      sandbox=$3
      shift 3
      if [ "$sub" = allow ]; then
        [ $# -eq 1 ] || return 2
        resource=$1
        [ "$resource" != "${SBX_MOCK_POLICY_ALLOW_FAIL:-}" ] || return 1
        printf '%s\n' "$resource" >>"$state/policy/$sandbox"
        if [ "$resource" = "${SBX_MOCK_POLICY_ALLOW_SIGNAL:-}" ]; then kill -TERM "$PPID"; fi
      else
        [ $# -eq 3 ] && [ "$1" = --resource ] && [ "$3" = --force ] || return 2
        resource=$2
        [ "$resource" != "${SBX_MOCK_POLICY_RM_FAIL:-}" ] || return 1
        tmp=$(mktemp)
        awk -v resource="$resource" '$0 != resource' "$state/policy/$sandbox" >"$tmp"
        mv "$tmp" "$state/policy/$sandbox"
      fi
      return 0 ;;
    *) printf 'mock sbx: unsupported policy command: %s\n' "$sub" >&2; return 2 ;;
  esac
}

cmd=${1:-}
shift || true
case $cmd in
  ls) cmd_ls "$@" ;;
  create) cmd_create "$@" ;;
  run) cmd_run "$@" ;;
  rm) cmd_rm "$@" ;;
  stop) cmd_stop "$@" ;;
  exec) do_exec "$@" ;;
  mcp) cmd_mcp "$@" ;;
  skills) cmd_skills "$@" ;;
  policy) cmd_policy "$@" ;;
  *)
    printf 'mock sbx: unsupported command: %s\n' "$cmd" >&2
    exit 2
    ;;
esac
